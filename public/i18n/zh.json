  "OVERVIEW_FEATURE": {
    "TITLE": "SOFICloud，功能丰富、值得信赖的企业资源规划（ERP）软件",
    "DESCRIPTION": "SOFICloud 专为在单一集成系统中支持关键企业流程而设计。从财务、销售、采购、库存、生产、项目、工作流到业务分析，各项功能紧密互联，并在一致的数据流中协同运行。凭借在各行各业的实施经验，SOFICloud 不断进化以满足日益复杂的业务需求。",
    "TARGET_REVENUE": {
      "LABEL": "目标收入",
      "VALUE": "92%"
    },
    "APPROVAL": {
      "LABEL": "今日审批",
      "VALUE": "18 份文档"
    },
    "ARIA": {
      "IMAGE_ALT": "带有业务绩效小组件的 SOFICloud ERP 仪表板监控屏幕预览"
    }
  },
  "FEATURES": {
    "HEADING": "SOFICloud 九大核心功能",
    "SUBTITLE": "相互互联的综合功能，旨在简化日常运营流程并提供一致的管理洞察。",
    "CTA_LEARN_MORE": "了解更多",
    "CARDS": {
      "FINANCIAL": {
        "TITLE": "财务管理与会计核算",
        "DESC": "管理从日常业务交易到财务报表、资金控制、成本分析和管理洞察的全流程财务与会计业务。"
      },
      "SALES": {
        "TITLE": "销售与订单管理",
        "DESC": "管理从报价单、销售订单、订单履行到发货、开票和收入监控的整个销售周期。"
      },
      "PROCUREMENT": {
        "TITLE": "采购与供应商管理",
        "DESC": "涵盖从请购单、审批流程、供应商管理、采购订单到收货入库与供应商发票的全面采购需求。"
      },
      "INVENTORY": {
        "TITLE": "库存与仓库管理",
        "DESC": "具备库位、分配、调拨、盘点和库存控制功能，实时监控多仓库的物料库存与流转动态。"
      },
      "MANUFACTURING": {
        "TITLE": "制造与生产控制",
        "DESC": "全面管理从物料清单（BOM）、工艺路线、物料需求计划（MRP）到生产工单、在制品（WIP）及生产成本分析。"
      },
      "PROJECT": {
        "TITLE": "项目与成本管理",
        "DESC": "统筹项目预算、施工进度和实际支出，精准监控各项目的成本支出、预算对比与项目盈利水平。"
      },
      "WORKFLOW": {
        "TITLE": "工作流、审批与内部控制",
        "DESC": "根据企业组织架构定制审批工作流、多级权限与授权控制，配备完备的处理状态与审计追踪。"
      },
      "ANALYTICS": {
        "TITLE": "商业分析与数据报表",
        "DESC": "将日常业务交易转化为直观的可视化仪表盘、综合报表和深入分析，助力管理层做出明智决策。"
      },
      "SECURITY": {
        "TITLE": "安全、云端与审计保障",
        "DESC": "通过基于角色的权限控制、完备审计追踪、云端安全访问、定期备份和实时监控保护系统与数据安全。"
      }
    }
  },
